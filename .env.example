# Application Runtime
APP_NAME=SlotGuard Booking API
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8102
LOG_LEVEL=INFO

# Database (Local default: SQLite WAL | Docker: postgresql+psycopg://slotguard:change-me@postgres:5432/slotguard)
DATABASE_URL=sqlite+aiosqlite:///./slotguard_dev.db

# Rate Limiter (memory | redis)
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6382/0
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_BOOKING_REQUESTS=60
RATE_LIMIT_WEBHOOK_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Authentication (replace secrets before production deployment)
JWT_SECRET=dev-only-change-me-before-production-use-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Booking & Payment Webhook Security
BOOKING_HOLD_TTL_SECONDS=900
WEBHOOK_SECRET=dev-only-webhook-secret-change-me-in-production
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# Background Maintenance Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=30

# Docker Compose Metadata
POSTGRES_DB=slotguard
POSTGRES_USER=slotguard
POSTGRES_PASSWORD=change-me-in-local-docker-env
REDIS_HOST_PORT=6382
COMPOSE_PROJECT_NAME=be02_slot_booking_api
